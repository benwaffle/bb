{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@get-bb/plugin-sdk": [
        "../../packages/plugin-sdk/bundled-types/bb-plugin-sdk.d.ts"
      ],
      "@get-bb/plugin-sdk/app": [
        "../../packages/plugin-sdk/bundled-types/bb-plugin-sdk-app.d.ts"
      ]
    },
    "types": [
      "node"
    ],
    "jsx": "react-jsx"
  },
  "include": [
    "server.ts",
    "app.tsx",
    "src",
    "vitest.config.ts"
  ]
}
